# Clerk (clerk.com). Register this instance's JWKS in the Chipi dashboard, with an `aud` rule.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Chipi (dashboard.chipipay.com). The org needs AI credits: every decision calls /v1/ai/think.
NEXT_PUBLIC_CHIPI_API_KEY=pk_prod_...
CHIPI_SECRET_KEY=sk_prod_...

# Encrypts every agent's session key at rest. At least 32 random characters: openssl rand -hex 32
# Rotating it orphans the stored sessions (users re-hire their agent).
VELA_SESSION_SECRET=

# Optional: the largest wallet (in USD) the agent agrees to manage. Default 100.
# MAX_DEPOSIT_USD=100

# Sent by the scheduler as `Authorization: Bearer $CRON_SECRET` to /api/tick.
CRON_SECRET=

# Postgres (Neon, Railway, Supabase, Vercel Postgres). Tables are created on first use.
DATABASE_URL=postgres://...
# DATABASE_SSL=false   # for a local Postgres without TLS

# Optional: your own Starknet mainnet RPC (default: Cartridge's public node).
# STARKNET_RPC_URL=
