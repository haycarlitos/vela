# Chipi (dashboard.chipipay.com): the only two values you must set. The org needs AI credits:
# every decision calls /v1/ai/think. In the dashboard, set your API key's JWKS to
# https://<your-app>/api/auth/jwks with the Better Auth provider.
NEXT_PUBLIC_CHIPI_API_KEY=pk_prod_...
CHIPI_SECRET_KEY=sk_prod_...

# Optional: where the app runs (passkeys are bound to its hostname). Default: Vercel's production
# URL, or http://localhost:3000.
# BETTER_AUTH_URL=
# Optional: signs Better Auth's cookies and encrypts its JWT signing key. Default: derived from
# CHIPI_SECRET_KEY. If that key rotates while this is unset, everyone signs in again and you must
# delete the rows of the `jwks` table (a new signing key is created on the next sign-in).
# Set this (openssl rand -hex 32) before rotating to avoid both.
# BETTER_AUTH_SECRET=

# Optional: encrypts every agent's session key at rest. By default Vela derives this key from
# CHIPI_SECRET_KEY, so rotating that key orphans the stored sessions (users re-hire their agent).
# Set this (at least 32 random characters: openssl rand -hex 32) to rotate them independently.
# VELA_SESSION_SECRET=

# Optional: the largest wallet (in USD) the agent agrees to manage. Default 100.
# MAX_DEPOSIT_USD=100

# Optional: "true" lets an agent pay for its AI decisions per call over x402 ($0.015 each, at most
# $0.02), from its own session, when your org has no AI credits (course module 12). The session
# then also whitelists `transfer`, capped by the USDC spending policy. Agents hired before you turn
# it on cannot pay: they stop and hire again.
# VELA_PAY_AI_WITH_X402=true

# Optional: minutes between two decisions of the same agent. Default 1440 (daily, what Vercel Hobby's
# cron runs). /api/tick enforces this itself, so any scheduler can call it more often.
# TICK_INTERVAL_MINUTES=1440

# Optional, recommended in production: /api/tick then requires `Authorization: Bearer <CRON_SECRET>`.
# Vercel Cron sends it by itself; give an external scheduler (Trigger.dev, QStash) the same header.
# CRON_SECRET=

# Postgres (Neon, Railway, Supabase, Vercel Postgres). Tables are created on first use.
DATABASE_URL=postgres://...
# DATABASE_SSL=false   # for a local Postgres without TLS

# Optional: your own Starknet mainnet RPC (default: Cartridge's public node).
# STARKNET_RPC_URL=
